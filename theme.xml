<theme>
	<formatVersion>4</formatVersion>
	<include>./carbon.xml</include>

	<!-- CLON3D CYBERDECK v2.0 - TACTICAL COMMAND CENTER -->
	<!-- Complete redesign: Military avionics aesthetic -->
	<!-- NO Carbon visual elements remain -->

	<view name="system">

		<!-- Full-screen background with tech grid overlay -->
		<image name="background" extra="true">
			<tile>false</tile>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<path>./art/cyberdeck_hud_overlay.svg</path>
		</image>

		<!-- Background pattern layer -->
		<image name="bg_pattern" extra="true">
			<tile>false</tile>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<path>./art/cyberdeck_background_pattern.svg</path>
		</image>

		<!-- Tactical header bar (system status and branding) -->
		<image name="header_tactical" extra="true">
			<tile>false</tile>
			<size>1 0.11</size>
			<pos>0.5 0</pos>
			<origin>0.5 0</origin>
			<path>./art/cyberdeck_tactical_header.svg</path>
		</image>

		<!-- Left side information panel -->
		<image name="left_panel_info" extra="true">
			<tile>false</tile>
			<size>0.15 0.75</size>
			<pos>0.02 0.5</pos>
			<origin>0 0.5</origin>
			<path>./art/cyberdeck_side_panel_left.svg</path>
		</image>

		<!-- Center: Large dominant system logo -->
		<image name="logo_frame" extra="true">
			<tile>false</tile>
			<size>0.35 0.75</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/cyberdeck_logo_frame.svg</path>
		</image>

		<!-- System logo (dominant focal point - 60% of display) -->
		<image name="logo">
			<path>./art/logo/${system.theme}.svg</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.32 0.70</maxSize>
			<color>00d9ffff</color>
		</image>

		<!-- Right side quick access panel -->
		<image name="right_panel_info" extra="true">
			<tile>false</tile>
			<size>0.15 0.75</size>
			<pos>0.98 0.5</pos>
			<origin>1 0.5</origin>
			<path>./art/cyberdeck_side_panel_right.svg</path>
		</image>

		<!-- System name overlay text (minimal) -->
		<text name="system_name" extra="true">
			<pos>0.5 0.25</pos>
			<origin>0.5 0</origin>
			<size>0.35 0.06</size>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<fontSize>0.048</fontSize>
			<color>00d9ffff</color>
			<alignment>center</alignment>
			<forceUppercase>true</forceUppercase>
		</text>

		<!-- Corner bracket decorations -->
		<image name="corner_hud" extra="true">
			<tile>false</tile>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/cyberdeck_corner_elements.svg</path>
		</image>

		<!-- Tactical footer bar (commands and system info) -->
		<image name="footer_tactical" extra="true">
			<tile>false</tile>
			<size>1 0.095</size>
			<pos>0.5 1</pos>
			<origin>0.5 1</origin>
			<path>./art/cyberdeck_tactical_footer.svg</path>
		</image>

		<!-- Help system (minimal, tactical) -->
		<helpsystem name="help">
			<textColor>00d9ffff</textColor>
			<iconColor>00d9ffff</iconColor>
			<pos>0.02 0.92</pos>
			<fontSize>0.025</fontSize>
		</helpsystem>

	</view>

	<!-- Game list views inherited from carbon.xml (minimal changes to basic/detailed/video) -->

</theme>
