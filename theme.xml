<theme>
	<formatVersion>4</formatVersion>
    <include>./carbon.xml</include>

	<view name="system">
		<!-- Large Centered System Logo -->
		<image name="logo">
			<path>./art/logo/${system.theme}.svg</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.5 0.5</maxSize>
			<color>00d9ff</color>
		</image>

		<!-- System Name Text Below Logo -->
		<text name="logoText">
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<color>00d9ff</color>
			<forceUppercase>true</forceUppercase>
			<fontSize>0.08</fontSize>
			<pos>0.5 0.72</pos>
			<origin>0.5 0</origin>
			<alignment>center</alignment>
		</text>
	</view>

	<view name="basic, detailed, video">
		<text name="logoText">
			<pos>0.01 0.02</pos>
			<size>0.460 0.126</size>
			<fontSize>0.12</fontSize>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<color>00d9ff</color>
			<forceUppercase>true</forceUppercase>
		</text>
		<image name="logo">
			<path>./art/logo/${system.theme}.svg</path>
			<pos>0.266 0.074</pos>
			<maxSize>0.460 0.126</maxSize>
			<origin>0.5 0.5</origin>
			<color>00d9ff</color>
		</image>

		<image name="logo2" extra="true">
			<path>./art/controller/${system.theme}.svg</path>
			<pos>0.874 0.074</pos>
			<maxSize>0.460 0.126</maxSize>
			<origin>0.5 0.5</origin>
			<color>808080</color>
		</image>
	</view>
</theme>
