<theme>
	<formatVersion>4</formatVersion>
	<include>./carbon.xml</include>

	<!-- CLON3D CYBERDECK v3.0 - RADICAL ASYMMETRICAL REDESIGN -->
	<!-- Completely original interface, not based on Carbon composition -->
	<!-- Purpose-built dashboard for dedicated retro gaming hardware -->

	<view name="system">

		<!-- BACKGROUND: Industrial brushed metal texture (completely custom) -->
		<image name="background" extra="true">
			<tile>false</tile>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<path>./art/clon3d_brushed_metal.svg</path>
		</image>

		<!-- MINIMAL TOP HEADER (NOT a banner, just a status strip) -->
		<image name="header_minimal" extra="true">
			<tile>false</tile>
			<size>1 0.074</size>
			<pos>0.5 0</pos>
			<origin>0.5 0</origin>
			<path>./art/clon3d_minimal_header.svg</path>
		</image>

		<!-- LEFT SIDE: Large system logo frame (asymmetrical positioning) -->
		<image name="logo_frame_left" extra="true">
			<tile>false</tile>
			<size>0.42 0.83</size>
			<pos>0.22 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/clon3d_logo_frame_large.svg</path>
		</image>

		<!-- LEFT CENTER: System logo (large, natural positioning) -->
		<image name="logo">
			<path>./art/logo/${system.theme}.svg</path>
			<pos>0.22 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.38 0.78</maxSize>
			<color>00d9ffff</color>
		</image>

		<!-- SYSTEM NAME: Minimal overlay (subtle, not prominent) -->
		<text name="system_name" extra="true">
			<pos>0.22 0.15</pos>
			<origin>0.5 0</origin>
			<size>0.30 0.04</size>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<fontSize>0.035</fontSize>
			<color>00d9ffff</color>
			<alignment>center</alignment>
			<forceUppercase>true</forceUppercase>
		</text>

		<!-- RIGHT SIDE: Information ribbon (vertical stack, not panels) -->
		<image name="info_ribbon_right" extra="true">
			<tile>false</tile>
			<size>0.26 0.83</size>
			<pos>0.78 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/clon3d_info_ribbon.svg</path>
		</image>

		<!-- HARDWARE ACCENTS: Decorative port indicators -->
		<image name="hardware_accents" extra="true">
			<tile>false</tile>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/clon3d_hardware_accents.svg</path>
		</image>

		<!-- MINIMAL BOTTOM FOOTER (NOT a control bar, just info ribbon) -->
		<image name="footer_minimal" extra="true">
			<tile>false</tile>
			<size>1 0.093</size>
			<pos>0.5 1</pos>
			<origin>0.5 1</origin>
			<path>./art/clon3d_minimal_footer.svg</path>
		</image>

		<!-- HELP SYSTEM: Minimal tactical display -->
		<helpsystem name="help">
			<textColor>00d9ffff</textColor>
			<iconColor>00d9ffff</iconColor>
			<pos>0.02 0.90</pos>
			<fontSize>0.022</fontSize>
		</helpsystem>

	</view>

	<!-- Game list views inherited from carbon.xml (unchanged) -->

</theme>
