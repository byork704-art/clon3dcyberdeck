<theme>
	<formatVersion>4</formatVersion>
	<include>./carbon.xml</include>

	<!-- CLON3D CYBERDECK v1.0 - Industrial Military Aesthetic -->
	<!-- Complete system view redesign - No longer based on Carbon visual style -->

	<view name="system">

		<!-- Full-screen background with tech grid -->
		<image name="background" extra="true">
			<tile>false</tile>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<path>./art/cyberdeck_system_background.svg</path>
		</image>

		<!-- Industrial header bar (8% height) -->
		<image name="header_bar" extra="true">
			<tile>false</tile>
			<size>1 0.08</size>
			<pos>0.5 0</pos>
			<origin>0.5 0</origin>
			<path>./art/cyberdeck_header_bar.svg</path>
		</image>

		<!-- Left panel: Large centered system logo frame -->
		<image name="left_panel" extra="true">
			<tile>false</tile>
			<size>0.25 0.65</size>
			<pos>0.15 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/cyberdeck_left_panel_frame.svg</path>
			<color>00d9ffff</color>
		</image>

		<!-- Center: System logo (large, prominent) -->
		<image name="logo">
			<path>./art/logo/${system.theme}.svg</path>
			<pos>0.15 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.20 0.60</maxSize>
			<color>00d9ffff</color>
		</image>

		<!-- Center display panel -->
		<image name="center_display" extra="true">
			<tile>false</tile>
			<size>0.28 0.65</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/cyberdeck_center_display.svg</path>
		</image>

		<!-- System name text overlay -->
		<text name="system_name" extra="true">
			<pos>0.5 0.35</pos>
			<origin>0.5 0</origin>
			<size>0.35 0.08</size>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<fontSize>0.055</fontSize>
			<color>00d9ffff</color>
			<alignment>center</alignment>
			<forceUppercase>true</forceUppercase>
		</text>

		<!-- Game count display -->
		<text name="game_count" extra="true">
			<pos>0.5 0.50</pos>
			<origin>0.5 0</origin>
			<size>0.20 0.05</size>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<fontSize>0.035</fontSize>
			<color>00d9ffff</color>
			<alignment>center</alignment>
		</text>

		<!-- Right panel: HUD overlay -->
		<image name="right_hud" extra="true">
			<tile>false</tile>
			<size>0.25 0.65</size>
			<pos>0.85 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/cyberdeck_right_hud_panel.svg</path>
			<color>00d9ffff</color>
		</image>

		<!-- Corner bracket decorations -->
		<image name="corner_brackets" extra="true">
			<tile>false</tile>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<path>./art/cyberdeck_corner_brackets.svg</path>
		</image>

		<!-- Tactical footer bar (5% height) -->
		<image name="footer_bar" extra="true">
			<tile>false</tile>
			<size>1 0.05</size>
			<pos>0.5 1</pos>
			<origin>0.5 1</origin>
			<path>./art/cyberdeck_footer_bar.svg</path>
		</image>

		<!-- Help system (tactical cyan) -->
		<helpsystem name="help">
			<textColor>00d9ffff</textColor>
			<iconColor>00d9ffff</iconColor>
			<pos>0.02 0.92</pos>
		</helpsystem>

	</view>

	<!-- Game list views inherited from carbon.xml -->
	<!-- No changes to basic, detailed, video views -->

</theme>
