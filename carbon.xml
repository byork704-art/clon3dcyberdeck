<theme>
	<formatVersion>3</formatVersion>

	<view name="basic">

		<image name="background" extra="true">
			<tile>true</tile>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<path>./art/carbon_fiber.png</path>
		</image>

		<textlist name="gamelist">
			<selectorColor>1c1c1cff</selectorColor>
			<selectedColor>00d9ffff</selectedColor>
			<primaryColor>e0e0e0ff</primaryColor>
			<secondaryColor>808080ff</secondaryColor>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<fontSize>0.030</fontSize>
			<pos>0.025 0.18</pos>
			<size>0.950 0.73</size>
			<alignment>center</alignment>
			<horizontalMargin>0.01</horizontalMargin>
			<forceUppercase>1</forceUppercase>
			<scrollSound>./art/scroll.wav</scrollSound>
		</textlist>

	</view>

	<view name="detailed">

		<image name="background" extra="true">
			<tile>true</tile>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<path>./art/carbon_fiber.png</path>
		</image>

		<textlist name="gamelist">
			<selectorColor>1c1c1cff</selectorColor>
			<selectedColor>00d9ffff</selectedColor>
			<primaryColor>e0e0e0ff</primaryColor>
			<secondaryColor>808080ff</secondaryColor>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<forceUppercase>1</forceUppercase>
			<pos>0.021 0.168</pos>
			<size>0.489 0.754</size>
			<alignment>left</alignment>
			<horizontalMargin>0.00</horizontalMargin>
			<fontSize>0.03</fontSize>
			<scrollSound>./art/scroll.wav</scrollSound>
		</textlist>

		<image name="md_image">
			<pos>0.763 0.400</pos>
			<maxSize>0.453 0.436</maxSize>
			<origin>0.5 0.5</origin>
		</image>

	</view>

	<view name="video">

		<image name="background" extra="true">
			<tile>true</tile>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<path>./art/carbon_fiber.png</path>
		</image>

		<textlist name="gamelist">
			<selectorColor>1c1c1cff</selectorColor>
			<selectedColor>00d9ffff</selectedColor>
			<primaryColor>e0e0e0ff</primaryColor>
			<secondaryColor>808080ff</secondaryColor>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<forceUppercase>1</forceUppercase>
			<pos>0.021 0.168</pos>
			<size>0.489 0.754</size>
			<alignment>left</alignment>
			<horizontalMargin>0.00</horizontalMargin>
			<fontSize>0.03</fontSize>
			<scrollSound>./art/scroll.wav</scrollSound>
		</textlist>

		<video name="md_video">
			<pos>0.763 0.400</pos>
			<maxSize>0.366 0.436</maxSize>
			<origin>0.5 0.5</origin>
			<delay>0.2</delay>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>false</showSnapshotDelay>
		</video>

	</view>

</theme>
