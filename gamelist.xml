<theme>
	<formatVersion>4</formatVersion>

	<!-- CLON3D CYBERDECK OS - GAME LIST VIEW -->
	<!-- Custom game carousel and selection interface -->
	<!-- Replaces Carbon game list functionality -->

	<view name="basic">

		<!-- Dark background with industrial texture -->
		<image name="background" extra="true">
			<tile>true</tile>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<path>./art/clon3d_dashboard_background.svg</path>
		</image>

		<!-- Top header bar -->
		<image name="header_bar" extra="true">
			<tile>false</tile>
			<size>1 0.12</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<path>./art/gamelist_header.svg</path>
		</image>

		<!-- Game list carousel (horizontal centered) -->
		<textlist name="gamelist">
			<selectorColor>00d9ff</selectorColor>
			<selectedColor>00d9ffff</selectedColor>
			<primaryColor>e0e0e0</primaryColor>
			<secondaryColor>808080</secondaryColor>
			<fontPath>./art/Cabin-Bold.ttf</fontPath>
			<fontSize>0.035</fontSize>
			<pos>0.05 0.35</pos>
			<size>0.90 0.40</size>
			<alignment>center</alignment>
			<horizontalMargin>0.01</horizontalMargin>
			<forceUppercase>1</forceUppercase>
			<scrollSound>./art/scroll.wav</scrollSound>
		</textlist>

		<!-- Bottom footer bar -->
		<image name="footer_bar" extra="true">
			<tile>false</tile>
			<size>1 0.12</size>
			<pos>0 1</pos>
			<origin>0 1</origin>
			<path>./art/gamelist_footer.svg</path>
		</image>

		<!-- Help system -->
		<helpsystem name="help">
			<textColor>00d9ffff</textColor>
			<iconColor>00d9ffff</iconColor>
			<pos>0.02 0.88</pos>
			<fontSize>0.022</fontSize>
		</helpsystem>

	</view>

</theme>
