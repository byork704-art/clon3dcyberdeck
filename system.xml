<theme>
	<formatVersion>4</formatVersion>

	<!-- CLON3D CYBERDECK OS - SYSTEM DASHBOARD VIEW v4.0 -->
	<!-- Asymmetric 3-column industrial dashboard layout -->
	<!-- Left Nav (14%) | Center Logo (60%) | Right Data (21.5%) -->

	<view name="system">

		<!-- FULL-SCREEN BACKGROUND: Radial gradient with diagonal grid -->
		<image name="background" extra="true">
			<tile>false</tile>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<path>./art/clon3d_dashboard_background.svg</path>
		</image>

		<!-- TOP STATUS BAR (8% height): CLON3D OS branding + status -->
		<image name="system_header" extra="true">
			<tile>false</tile>
			<size>1 0.08</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<path>./art/clon3d_system_header.svg</path>
		</image>

		<!-- LEFT NAVIGATION COLUMN (14% width): Nav index diamonds -->
		<image name="left_nav_panel" extra="true">
			<tile>false</tile>
			<size>0.14 0.84</size>
			<pos>0 0.08</pos>
			<origin>0 0</origin>
			<path>./art/clon3d_left_nav_panel.svg</path>
		</image>

		<!-- LOGO FRAME: Asymmetric industrial frame - NOT centered, offset left -->
		<image name="logo_frame" extra="true">
			<tile>false</tile>
			<size>0.60 0.80</size>
			<pos>0.17 0.10</pos>
			<origin>0 0</origin>
			<path>./art/clon3d_fullscreen_logo_frame.svg</path>
		</image>

		<!-- SYSTEM LOGO: Featured inside asymmetric frame -->
		<image name="logo">
			<path>./${system.theme}/art/system.svg</path>
			<pos>0.47 0.50</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.52 0.68</maxSize>
			<color>00d9ffff</color>
		</image>

		<!-- RIGHT OPERATIONAL DATA PANEL (21.5% width): System stats feed -->
		<image name="right_data_panel" extra="true">
			<tile>false</tile>
			<size>0.215 0.84</size>
			<pos>0.785 0.08</pos>
			<origin>0 0</origin>
			<path>./art/clon3d_right_data_panel.svg</path>
		</image>

		<!-- BOTTOM COMMAND BAR (9.5% height): Controls and hints -->
		<image name="system_footer" extra="true">
			<tile>false</tile>
			<size>1 0.095</size>
			<pos>0 1</pos>
			<origin>0 1</origin>
			<path>./art/clon3d_system_footer.svg</path>
		</image>

		<!-- HELP SYSTEM: Tactical minimal display -->
		<helpsystem name="help">
			<textColor>00d9ffff</textColor>
			<iconColor>00d9ffff</iconColor>
			<pos>0.02 0.91</pos>
			<fontSize>0.020</fontSize>
		</helpsystem>

	</view>

</theme>
